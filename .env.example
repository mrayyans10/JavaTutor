# Copy this file to .env.local and fill in your own values.
# Never commit real API keys - .env* files (except this example) are gitignored.

# Optional: if set, the AI tutor and code evaluator use a real AI provider
# (OpenAI-compatible Chat Completions API). If omitted, the app falls back
# to a built-in rule-based evaluator and scripted tutor replies, so the
# platform remains fully usable without any key.
OPENAI_API_KEY=

# Optional: override the default model used for tutor chat and evaluation.
AI_MODEL=gpt-4o-mini
